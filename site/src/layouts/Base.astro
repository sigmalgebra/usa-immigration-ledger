---
import { latestPeriod, quarterLabel } from "../lib/ledger";

interface Props { title: string; description: string; path?: string }
const { title, description } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = site + Astro.url.pathname;
const fullTitle = title === "USA Immigration Ledger" ? title : `${title} · USA Immigration Ledger`;
const nav = [
  ["/", "Investigation"],
  ["/forms/", "Find your form"],
  ["/visa-queue/", "Visa queue"],
  ["/visas-issued/", "Visas issued"],
  ["/source-errors/", "Errors we found"],
  ["/data/", "Data"],
  ["/methodology/", "Methodology"],
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="/">USA Immigration Ledger</a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => (
          <a href={href} aria-current={(href === "/" ? here === "/" : here.startsWith(href)) ? "page" : undefined}>{label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p>
        An independent, open-source investigation. Not affiliated with USCIS, DHS or the U.S. Department of State.
        Data through {quarterLabel(latestPeriod())}. Every number links to the government file it came from.
      </p>
      <p>
        <a href="https://github.com/sigmalgebra/usa-immigration-ledger">Source code and data on GitHub</a> ·{" "}
        <a href="/data/">Download the dataset</a> · <a href="/methodology/#corrections">Corrections</a>
      </p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --page: #f9f9f7;
    --surface: #fcfcfb;
    --ink: #0b0b0b;
    --ink-2: #52514e;
    --muted: #898781;
    --grid: #e1e0d9;
    --axis: #c3c2b7;
    --rule: rgba(11, 11, 11, 0.1);
    --accent: #1c5cab;
    --mark-bg: #fff4d6;
    --series-1: #2a78d6;
    --series-2: #eb6834;
    --series-3: #1baf7a;
    --series-4: #eda100;
    --series-5: #e87ba4;
    --warn: #b25e00;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --page: #0d0d0d;
      --surface: #1a1a19;
      --ink: #f0efec;
      --ink-2: #c3c2b7;
      --muted: #898781;
      --grid: #2c2c2a;
      --axis: #383835;
      --rule: rgba(255, 255, 255, 0.1);
      --accent: #86b6ef;
      --mark-bg: #3a2f12;
      --series-1: #3987e5;
      --series-2: #d95926;
      --series-3: #199e70;
      --series-4: #c98500;
      --series-5: #d55181;
      --warn: #fab219;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --page: #0d0d0d;
    --surface: #1a1a19;
    --ink: #f0efec;
    --ink-2: #c3c2b7;
    --muted: #898781;
    --grid: #2c2c2a;
    --axis: #383835;
    --rule: rgba(255, 255, 255, 0.1);
    --accent: #86b6ef;
    --mark-bg: #3a2f12;
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #c98500;
    --series-5: #d55181;
    --warn: #fab219;
  }

  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font: 17px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  a { color: var(--accent); text-underline-offset: 2px; }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 2; }

  .site-header { border-bottom: 1px solid var(--rule); background: var(--surface); }
  .header-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 24px; padding-top: 14px; padding-bottom: 12px; }
  .brand { font-weight: 700; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
  nav { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 15px; }
  nav a { color: var(--ink-2); text-decoration: none; }
  nav a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; }

  main { padding-top: 32px; padding-bottom: 64px; }
  .prose { max-width: 680px; }
  h1 { font-size: clamp(30px, 5vw, 44px); line-height: 1.12; letter-spacing: -0.02em; margin: 8px 0 16px; max-width: 820px; }
  h2 { font-size: 26px; line-height: 1.25; margin: 48px 0 12px; letter-spacing: -0.01em; }
  h3 { font-size: 19px; margin: 28px 0 8px; }
  .kicker { text-transform: uppercase; letter-spacing: 0.08em; font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .dek { font-size: 20px; line-height: 1.5; color: var(--ink-2); max-width: 720px; }
  .byline { font-size: 14px; color: var(--muted); }
  p, li { max-width: 680px; }
  .fig { color: inherit; font-weight: 600; text-decoration: underline dotted var(--muted); text-decoration-thickness: 1px; }
  .fig:hover { text-decoration-color: var(--accent); color: var(--accent); }
  .note { font-size: 15px; color: var(--ink-2); }
  code { font-size: 0.9em; background: var(--surface); border: 1px solid var(--rule); border-radius: 4px; padding: 0 4px; }

  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin: 28px 0; }
  .tile { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 16px; }
  .tile .label { font-size: 14px; color: var(--ink-2); }
  .tile .value { font-size: 30px; font-weight: 650; letter-spacing: -0.01em; line-height: 1.2; margin: 4px 0; }
  .tile .value a { color: inherit; text-decoration: none; }
  .tile .delta { font-size: 14px; color: var(--ink-2); }

  .chart { margin: 28px 0; background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 16px; }
  .chart-title { display: block; font-weight: 650; }
  .chart-sub { display: block; font-size: 14px; color: var(--ink-2); }
  .legend { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 0; margin: 10px 0 0; font-size: 14px; color: var(--ink-2); }
  .legend .key { display: inline-block; width: 16px; height: 2px; vertical-align: middle; margin-right: 6px; border-radius: 1px; }
  .key.s1 { background: var(--series-1); } .key.s2 { background: var(--series-2); }
  .key.s3 { background: var(--series-3); } .key.s4 { background: var(--series-4); } .key.s5 { background: var(--series-5); }
  .plot { margin-top: 8px; min-height: 200px; }
  .plot svg { display: block; max-width: 100%; height: auto; color: var(--muted); }
  .plot .grid { stroke: var(--grid); }
  .plot .baseline { stroke: var(--axis); }
  .plot .line { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .plot .line.s1 { stroke: var(--series-1); } .plot .line.s2 { stroke: var(--series-2); }
  .plot .line.s3 { stroke: var(--series-3); } .plot .line.s4 { stroke: var(--series-4); } .plot .line.s5 { stroke: var(--series-5); }
  .plot .wash { stroke: none; fill-opacity: 0.1; }
  .plot .wash.s1 { fill: var(--series-1); } .plot .wash.s2 { fill: var(--series-2); }
  .plot .enddot { stroke: var(--surface); stroke-width: 2px; }
  .plot .enddot.s1 { fill: var(--series-1); } .plot .enddot.s2 { fill: var(--series-2); }
  .plot .enddot.s3 { fill: var(--series-3); } .plot .enddot.s4 { fill: var(--series-4); } .plot .enddot.s5 { fill: var(--series-5); }
  .plot .endlabel { fill: var(--ink); font-weight: 600; }
  .plot .crosshair { stroke: var(--axis); }
  .plot .tip { --plot-background: var(--surface); color: var(--ink); fill: var(--ink); }
  .plot [aria-label="tip"] path { fill: var(--surface); stroke: var(--axis); }
  .plot text { fill: currentColor; }
  .plot .endlabel text, .plot .tip text { fill: var(--ink); }

  .table-view { margin-top: 8px; font-size: 14px; }
  .table-view summary { cursor: pointer; color: var(--ink-2); }
  .table-scroll { overflow-x: auto; max-width: 100%; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; margin-top: 8px; }
  th, td { text-align: left; padding: 6px 10px 6px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-weight: 600; color: var(--ink-2); }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }

  .callout { background: var(--mark-bg); border-radius: 8px; padding: 14px 16px; margin: 24px 0; max-width: 720px; }
  .callout p { margin: 6px 0; }
  .finding { border-left: 3px solid var(--accent); padding-left: 16px; margin: 24px 0; }
  .finding h3 { margin-top: 0; }
  .pill { display: inline-block; font-size: 12px; border: 1px solid var(--rule); border-radius: 999px; padding: 0 8px; color: var(--ink-2); }
  .pill.warn { border-color: var(--warn); color: var(--warn); }

  .site-footer { border-top: 1px solid var(--rule); font-size: 14px; color: var(--ink-2); padding: 24px 0 40px; }
</style>
